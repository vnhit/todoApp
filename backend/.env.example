DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite: chạy local không cần cài database. Production dùng postgresql.
DB_ENGINE=sqlite
DB_NAME=todo_dashboard
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Production: DJANGO_DEBUG=False, HTTPS và origin thật của ứng dụng.
DJANGO_CSRF_TRUSTED_ORIGINS=
